# ---------------------------------------------------------------------------
# SVG Template Helpers
# ---------------------------------------------------------------------------

def _svg_wrapper(content: str, width: int = 120, height: int = 40) -> str:
    """Wrap SVG content with standard attributes."""
    return f"""<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {width} {height}" width="{width}" height="{height}" fill="none">
{content}
</svg>"""


def _rect_bg(color: str = COLORS["background"], width: int = 120, height: int = 40) -> str:
    """Generate a background rectangle."""
    return f'  <rect width="{width}" height="{height}" rx="6" fill="{color}"/>'


def _vendor_text(name: str, x: int = 60, y: int = 24, color: str = COLORS["text"]) -> str:
    """Generate centered vendor name text."""
    return f'  <text x="{x}" y="{y}" font-family="Inter, system-ui, sans-serif" font-size="11" font-weight="600" fill="{color}" text-anchor="middle" dominant-baseline="middle">{name}</text>'


def _vendor_icon(cx: int, cy: int, r: int = 6, color: str = COLORS["primary"]) -> str:
    """Generate a simple circle icon representing the vendor."""
    return f'  <circle cx="{cx}" cy="{cy}" r="{r}" fill="{color}"/>'


def _status_indicator(x: int, y: int, status: str = "active") -> str:
    """Generate a small status dot."""
    status_colors = {
        "active": COLORS["success"],
        "warning": COLORS["warning"],
        "inactive": COLORS["neutral"],
        "error": COLORS["danger"],
    }
    color = status_colors.get(status, COLORS["neutral"])
    return f'  <circle cx="{x}" cy="{y}" r="3" fill="{color}"/>'


